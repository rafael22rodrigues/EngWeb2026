extends ../layout

block content 
    .page
        h1 Favoritos
        if favoritos.length > 0
            .favorites-list
                for item in favoritos
                    .favorites-item
                        img(src=item.imagemBase, alt=item.produtoId style="width: 160px; height: 160px; object-fit: cover; min-width: 160px; min-height: 200px; border-radius: 12px")
                        .item-details
                            .item-info
                                h2= item.produtoNome
                                if item.variantes
                                    p.preco Desde #{item.precoBase}€
                                else
                                    p.preco #{item.precoBase}€
                            .item-buttons
                                a(href=`/produtos/${item.produtoId}`)
                                    button.btn-ver Ver Produto
                                form(action='/wishlist/remover' method='POST' onsubmit='this.submit()')
                                    input(type='hidden' name='produtoId' value=item.produtoId)
                                    button.btn-apagar(type='submit') Apagar dos Favoritos
        else
            p Não marcaste nada como favorito

    style.
        .page{
            display: flex;
            flex-direction: column;
            padding: 40px 60px;
        }

        h1{
            color: #000;
            leading-trim: both;
            text-edge: cap;
            font-family: "DM Sans", sans-serif;
            font-size: 48px;
            font-style: normal;
            font-weight: 600;
            line-height: normal;
            margin-bottom: 32px;
        }
        .favorites-list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
            max-width: 1800px;
            width: 100%;
        }
        .favorites-item{
            display: flex;
            align-items: center;
            gap: 20px;
            border-radius: 38px;
            border: 1px solid #000;
            background: #FFF;
            padding: 16px 24px;
        }
        .item-details {
            display: flex;
            flex-direction: column;
            gap: 12px;
            flex: 1;
        }
        .item-info h2 {
            color: #000;
            leading-trim: both;
            text-edge: cap;
            font-family: "DM Sans", sans-serif;
            font-size: 48px;
            font-style: normal;
            font-weight: 600;
            line-height: normal;
        }

        .item-info .preco {
            font-family: "DM Sans", sans-serif;
            font-size: 18px;
            color: #CBAB75;
            font-weight: 600;
            margin: 4px 0 0;
        }
        .item-buttons {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .item-buttons a {
            text-decoration: none;
        }

        .item-buttons form {
            margin: 0;
        }

        .btn-ver {
            background: #000;
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 10px 24px;
            font-family: "DM Sans", sans-serif;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-apagar {
            background: #fff;
            color: #000;
            border: 2px solid #000;
            border-radius: 12px;
            padding: 10px 24px;
            font-family: "DM Sans", sans-serif;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-ver:hover {
            background: #333;
        }

        .btn-apagar:hover {
            background: #f5f5f5;
        }
