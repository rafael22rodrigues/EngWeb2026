extends ../layout
include ../../components/formCard.pug

block content
  
  .contact-page
    .contact-img
      img(src="/assets/background/bg-contact.png", alt="Imagem de fundo contacto")

    .contact-container
      section.contact-card
        .contact-info
          h1.contact-title
            | Entre Em Contacto
            br
            | Connosco

          .info-block
            .info-label
              img(src="/assets/location.png", alt="Endereço")
              span Endereço
            .info-value Rua do Comércio, Vilarinho das Cambas, Vila Nova de Famalicão #[br] Loja nº 137, Pavilhão C

          .info-block
            .info-label
              img(src="/assets/phone.png", alt="Telefone")
              span Telefone
            .info-value +351 961 234 567

          .info-block
            .info-label
              img(src="/assets/mail.png", alt="Email")
              span Email
            .info-value dianadecor@email.com

        .form-wrapper
          +formCard(
            'Entre Em Contacto Connosco',
            '',
            '',
            '',
            'Enviar Mensagem',
            'contact'
          )

      section.map-section
        .map-card
          iframe(
            src="https://www.google.com/maps?q=R.%20do%20Com%C3%A9rcio%2C%204760-739%20Vilarinho%20das%20Cambas&output=embed"
            width="100%"
            height="400"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          )

  style.
    .contact-page {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'DM Sans', sans-serif;
      background: #FFFFFF;
      color: var(--text-color);
    }

    .contact-img {
      width: 100%;
      height: 420px;
      position: relative;
    }

    .contact-container {
      max-width: 1100px;
      margin: -200px auto 80px auto;
      position: relative;
    }

    .contact-card {
      background: var(--form-bg);
      padding: 60px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .contact-info {
      padding: 40px 0;
    }

    .contact-title {
      font-size: 35px;
      font-weight: 700;
      margin-bottom: 80px;
    }

    .info-block {
      margin-bottom: 28px;
    }

    .info-label {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      color: #7e7e7e;
      margin-bottom: 10px;
    }

    .info-label img {
      width: 16px;
      height: 16px;
      object-fit: contain;
    }

    .info-value {
      font-size: 16px;
      font-weight: 700;
      line-height: 1.4;
      color: var(--text-color);
      padding-left: 26px;
    }

    .form-wrapper {
      display: flex;
      justify-content: flex-end;
    }

    .map-section {
      margin: 60px 0;
      display: flex;
      justify-content: center;
    }

    .map-card {
      width: 100%;
      max-width: 1100px;
      overflow: hidden;
    }

    .map-card iframe {
      display: block;
      border: 0;
    }