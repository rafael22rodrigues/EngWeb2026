extends ../layout
include ../../components/table.pug
include ../../components/pagination.pug

block content
  main.main
    section.page-card
      .top-section
        .page-card-header
          .title
            img(src="/assets/admin.png" alt="Admin Icon")
            h1 Gestão de Stock
          p Ver, editar e apagar produtos do inventário
          // button(type="button" onclick="window.location.href='/admin/inventario/novo'")
          //   .plus-icon +
          //   p Adicionar Produto
        .stats
          div.stats-card 
            .stats-card-content
              img(src="/assets/box-icon.svg" alt="Produtos")
              p=stats.numProdutos
            p.stats-card-caption produtos
          div.stats-card 
            .stats-card-content
              p=stats.vendas
            p.stats-card-caption vendidos
          div.stats-card 
            .stats-card-content
              p=stats.precoMedio + '€'
            p.stats-card-caption preço médio
          div.stats-card 
            .stats-card-content
              p=stats.faturacao + '€'
            p.stats-card-caption faturados
      .opcoes
        form.filters(method="get" action="/admin/inventario")
          .filters-top
            div.cor
              label.label(for="cor") Cor:
              select.dropdown(name="cor" onchange="this.form.submit()")
                option(value="" selected=((filtros && filtros.cor) === '')) Todas
                each cor in opcoesFiltro.cores
                  option(value=cor._id selected=(filtros && filtros.cor === cor._id))= cor.label

            div.categoria
              label.label(for="categoria") Categoria:
              select.dropdown(name="categoria" onchange="this.form.submit()")
                option(value="" selected=((filtros && filtros.categoria) === '')) Todas
                each categoria in opcoesFiltro.categorias
                  option(value=categoria._id selected=(filtros && filtros.categoria === categoria._id))= categoria.label

            div.preco 
              label.label(for="preco") Preço:
              input.input-price(type="number" name="minPreco" placeholder="Mín" value=(filtros && filtros.minPreco) || '' style="width:80px;" onchange="this.form.submit()")
              span.label(style="margin-left:8px;") -
              input.input-price(type="number" name="maxPreco" placeholder="Máx" value=(filtros && filtros.maxPreco) || '' style="width:80px;" onchange="this.form.submit()")

            a.button(href="/admin/inventario")
                img(style="width:23px" src="/assets/clear-filters.svg" alt="Limpar Filtros")
                p Limpar

          .filters-bottom
            .left-section
              a.button(href='/admin/produtos/novo' class='filtros' style='text-decoration:none;background-color:var(--main-color)')
                img(src="/assets/plus-icon.svg" alt="Adicionar" style="width:19px;")
                span Adicionar Produto

              div.search
                img(src="/assets/lupa-icon.svg" alt="Pesquisar")
                input(type="text" name="search" placeholder="Pesquisar por nome..." value=(filtros && filtros.search) || '' onkeydown="if (event.key === 'Enter') this.form.requestSubmit()")

            div.order-filtros
              div.order
                label.label(for="order") Ordenar por:
                select.dropdown(name="sort" onchange="this.form.submit()")
                  option(value="nome_asc" selected=((filtros && filtros.sort) === 'nome_asc')) Nome (A-Z)
                  option(value="nome_desc" selected=((filtros && filtros.sort) === 'nome_desc')) Nome (Z-A)
                  option(value="preco_asc" selected=((filtros && filtros.sort) === 'preco_asc')) Preço (Ascendente)
                  option(value="preco_desc" selected=((filtros && filtros.sort) === 'preco_desc')) Preço (Descendente)
      .table-wrapper
        +table(['Imagem', 'Nome', 'Preço', 'Categoria', 'Cores', 'Tamanhos', 'Stock', 'Vendidos', 'Ações'], rows)
      +pagination(pagination)
  
  style. 
    .main {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem;
    }

    .page-card {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1.5rem;
      width: 80%;
    }

    .top-section {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    .page-card-header button {
      height: 40px;
      color: white;
      outline: none;
      border: none;
      font-size: 14px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: left;
      gap: 8px;
      background: transparent;
    }

    .page-card-header button p {
      margin: 0;
      color: var(--main-color);
      font-size: 17px;
      font-weigth: 600;
    }
    .plus-icon {
      width: 36px;
      height: 36px;
      background-color: var(--main-color);
      color: var(--gray);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 32px;
    }

    .left-section {
      display: flex;
      align-items: center;
      gap: 20px;
      justify-content: flex-start;
    }

    .page-card-header {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .page-card-header h1 {
      margin: 0;
      font-size: 40px;
      color: #3b3b3b;
      font-weight: 700;
    }

    .page-card-header p {
      margin: 0;
      color: #5d524b;
    }

    .filters {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      width: 100%;
    }

    .opcoes {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      width: 100%;
    }

    .opcoes .button,
    .opcoes .filters {
      align-self: flex-start;
    }

    .filters-top,
    .filters-bottom {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      width: 100%;
    }

    .filters-top {
      justify-content: flex-end;
    }

    .filters-bottom {
      justify-content: space-between;
    }


    .table-wrapper {
      max-width: 1600px;
    }

    .order {
      display: inline-flex;
      align-items: center;
    }

    .label {
      margin-right: 10px;
      font-weight: 600;
      color: rgba(0, 0, 0, 0.65);
    }
    .dropdown {
      height: 40px;
      padding: 5px 10px;
      border: 2px solid var(--main-color);
      background-color: var(--gray);
    }

    .input-price {
      height: 25px;
      padding: 5px 10px;
      border: 2px solid var(--main-color);
      background-color: var(--gray);
    }

    .search {
      padding: 5px 10px;
      width: 600px;
      border: 2px solid var(--main-color);
      background-color: var(--gray);
      display: flex;
      align-items: center;
      gap: 5px;
      height: 30px;
    }

    .search img {
      width: 25px;
    }

    .search input {
      width: 100%;
      height: 100%;
      border: none;
      outline: none;
      background: transparent;
    }
    
    .button {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      height: 43px;
      padding: 5px 15px;
      color: white;
      background-color: var(--main-color);
      outline: none;
      border: none;
      font-size: 14px;
      font-weight: 600;
      white-space: nowrap;
      width: fit-content;
      box-sizing: border-box; 
      margin: 0;
      text-decoration: none;
    }
    .button:hover {
      background-color: var(--main-color-hover);
      outline: none;

    }
    .filtros button img {
      width: 16px;
    }

    .order-filtros{
      display: inline-flex;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .order,
    .cor,
    .categoria,
    .preco {
      white-space: nowrap;
    }

    .stats {
      width: 500px;
      height: 100px;
      color: white;
      font-weight: 600;
      font-size: 20px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      align-items: stretch;
      gap: 10px;
    }

    .stats-card {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      height: 100%;
      width: 100%;
      box-sizing: border-box;
      padding: 14px 0;
      gap: 6px;
    }

    .stats-card img {
      width: 28px;
      opacity: 0.8;
    }

    .stats-card-content {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .stats-card-content p {
      margin: 0;
      font-size: 34px;
      line-height: 1;
      font-weight: 800;
      color: rgba(0, 0, 0, 0.8);
      text-align: center;
    }

    .stats-card-caption {
      margin: 0;
      color: rgba(0, 0, 0, 0.65);
      text-align: center;
      font-size: 13px;
      line-height: 1.2;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .title {
      display: inline-flex;
      align-items: center;
      gap: 12px;
    }
    .title img {
      width: 40px;
    }

    .opcoes {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      gap: 20px;
    }

    .cor-preview {
      width:15px;
      height:15px;
      border-radius:5px;
      margin-right:1px;
      display:inline-block;
      border: 1px solid rgba(0, 0, 0, 0.1);
    }