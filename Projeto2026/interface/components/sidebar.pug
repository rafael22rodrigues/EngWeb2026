aside.sidebar#sidebar
  if user && user.tipo == 'admin'
    nav.sidebar-categories
      a(href='/admin/inventario') INVENTÁRIO
      a(href='/admin/encomendas') ENCOMENDAS
      a(href='/admin/users') UTILIZADORES
  else
    form.sidebar-search(action='/pesquisa' method='GET')
      img(src='/assets/lupa-icon.svg', alt='Pesquisar', style='width: 20px; height: 20px; cursor:pointer;' onclick='this.closest("form").submit()')
      input(type='text' name='q' placeholder='INSIRA O PRODUTO' autocomplete='off')

    nav.sidebar-categories
      each cat in (sidebarCategorias || [])
        a(href='/categoria/' + cat.slug)= cat.nome.toUpperCase() + ' '
          span >

    a.sidebar-ver-tudo(href='/produtos') VER TUDO
  if user==null || user.tipo !== 'admin'
    nav.sidebar-nav
      a(href='/') INICIO
      a(href='/sobre') SOBRE NOS
      a(href='/contactos') CONTACTOS

style.
  * { font-family: var(--font-principal); }
  :root {
    --castanho: #7D5A35;
    --sidebar-bg: #9e8070;
    --font-principal: 'DM Sans', sans-serif;
  }
  .sidebar-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 199;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .sidebar-overlay.active { opacity: 1; pointer-events: all; }
  .sidebar {
    position: fixed;
    top: 0; left: 0;
    width: 340px;
    height: 100vh;
    background: var(--sidebar-bg);
    z-index: 200;
    padding: 2rem 2.5rem;
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(.4, 0, .2, 1);
    overflow-y: auto;
  }
  .sidebar.active { transform: translateX(0); }
  .sidebar-search {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #f5f0eb;
    border-radius: 50px;
    padding: 10px 20px;
    margin-bottom: 2.5rem;
  }
  .sidebar-search input {
    background: none; border: none; outline: none;
    font-size: 0.8rem; letter-spacing: 2px; color: #555;
    width: 100%; font-family: inherit;
  }
  .sidebar-categories { display: flex; flex-direction: column; }
  .sidebar-categories a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #fff;
    text-decoration: none;
    font-size: 1.1rem;
    letter-spacing: 1px;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    transition: opacity 0.2s;
  }
  .sidebar-categories a:hover { opacity: 0.7; }
  .sidebar-categories a span { font-size: 0.9rem; opacity: 0.7; }
  .sidebar-ver-tudo {
    display: block;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.75rem;
    letter-spacing: 2px;
    text-decoration: none;
    margin: 1rem 0;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
  }
  .sidebar-nav { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; }
  .sidebar-nav a {
    color: #fff; text-decoration: none;
    font-size: 1rem; letter-spacing: 1px; transition: opacity 0.2s;
  }
  .sidebar-nav a:hover { opacity: 0.7; }

.sidebar-overlay#sidebarOverlay

script.
  document.addEventListener('DOMContentLoaded', () => {
    const menuBtn = document.getElementById('menuBtn');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');
    const adminMenuBtn = document.getElementById('adminMenuBtn');

    const toggleSidebar = () => {
      sidebar.classList.toggle('active');
      overlay.classList.toggle('active');
    };

    if (menuBtn && sidebar && overlay) {
      menuBtn.addEventListener('click', toggleSidebar);
    }

    if (adminMenuBtn && sidebar && overlay) {
      adminMenuBtn.addEventListener('click', toggleSidebar);
    }

    if (overlay && sidebar) {
      overlay.addEventListener('click', () => {
        sidebar.classList.remove('active');
        overlay.classList.remove('active');
      });
    }
  });
