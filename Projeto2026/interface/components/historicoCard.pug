include ./pagination.pug
mixin historicoCard(compras, comprasPagination)
    .purchases-box
        h2.purchases-title As minhas compras
        
        .purchase-list
            if compras && compras.length > 0
                each compra in compras
                    .purchase-row
                        .purchase-info
                            span.purchase-date= new Date(compra.data).toLocaleDateString('pt-PT')
                            span.purchase-price= compra.precoTotal.toFixed(2).replace('.', ',') + '€'
                        a.purchase-btn(href='/perfil/compras/' + compra._id)
                            img.history-icon(src='/assets/formIcons/eye-open.png', alt='Mostrar histórico de compra')
            else
                p.empty-message Lista de compras vazia.

        +pagination(comprasPagination)

    style.
        .purchases-box {
            width: 700px;
            max-height: 700px;
            background: var(--form-bg);
            padding: 34px 44px 28px 44px;
            box-sizing: border-box;
        }

        .purchases-title {
            text-align: center;
            font-size: 28px;
            font-weight: 700;
        }

        .purchase-list {
            display: flex;
            flex-direction: column;
            gap: 24px;
            margin: 0 20px;
        }

        .purchase-row {
            background: #ffffff;
            border: 1px solid #f0f0f0;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
        }

        .purchase-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .purchase-date {
            font-size: 14px;
            font-weight: 700;
        }

        .purchase-price {
            font-size: 12px;
            color: #a0a0a0;
        }

        .purchase-btn {
            background: var(--button-bg);
            border: none;
            border-radius: 50%;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .purchase-btn img {
            width: 22px;
            height: 22px;
            object-fit: contain;
            filter: brightness(0) invert(1);
        }

        .empty-message {
            text-align: center;
            color: #777;
            font-size: 15px;
            margin-top: 20px;
        }

        .pagination {
            display: flex;
            flex-direction: row;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin-top: 40px;
        }

        .page-num {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #dcdcdc;
            text-decoration: none;
            color: #333;
        }

        .page-num.active {
            background: var(--button-bg);
            color: white;
        }

        .next-btn {
            border: 1px solid #dcdcdc;
            padding: 0 15px;
            height: 32px;
            text-decoration: none;
            color: #333;
            display: flex;
            align-items: center;
        }