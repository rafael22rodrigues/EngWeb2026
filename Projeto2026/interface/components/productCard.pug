mixin productCard(produto)

  a.produto-card(href='/produtos/' + produto._id)
    .produto-imgs
      img(src=produto.imagemBase alt=produto.nome)
      button.produto-like(data-id=produto._id onclick='darLike(event, this)' aria-label='Adicionar aos favoritos')
        svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
          path(d='M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z')
    if produto.opcoes && produto.opcoes.cores && produto.opcoes.cores.length
      .produto-dots
        each cor in produto.opcoes.cores.slice(0, 3)
          span.produto-dot(style='background:' + cor._id)
    .produto-info
      span.produto-nome= produto.nome
      span.produto-preco
        if produto.precoMin === produto.precoMax
          | #{produto.precoMin}€
        else
          | Desde #{produto.precoMin}€

  style.
    .produto-card {
      text-decoration: none;
      color: var(--text-color);
      position: relative;
    }

    .produto-badge {
      position: absolute;
      top: 10px; left: 10px;
      background: var(--text-color);
      color: #fff;
      font-size: 0.7rem;
      font-weight: 700;
      padding: 3px 8px;
      letter-spacing: 1px;
      z-index: 1;
    }

    .produto-imgs {
      width: 100%;
      aspect-ratio: 1;
      overflow: hidden;
      background: #f5f0eb;
      border-radius: 4px;
      margin-bottom: 0.5rem;
    }

    .produto-imgs img {
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform 0.3s;
    }

    .produto-card:hover .produto-imgs img { transform: scale(1.04); }

    .produto-like {
      position: absolute;
      top: 10px; right: 10px;
      width: 36px; height: 36px;
      border-radius: 50%;
      border: none;
      background: white;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(0,0,0,0.15);
      opacity: 0;
      transform: scale(0.8);
      transition: opacity 0.2s, transform 0.2s;
      z-index: 2;
    }

    .produto-like svg {
      width: 16px; height: 16px;
      color: #aaa;
      transition: color 0.2s, fill 0.2s;
    }

    .produto-card:hover .produto-like {
      opacity: 1;
      transform: scale(1);
    }

    .produto-like.ativo svg {
      color: #e53935;
      fill: #e53935;
    }

    .produto-like:hover svg { color: #e53935; }

    .produto-dots { display: flex; gap: 5px; margin: 0.4rem 0; }

    .produto-dot {
      width: 10px; height: 10px;
      border-radius: 50%;
      border: 1px solid rgba(0,0,0,0.1);
      display: inline-block;
    }

    .produto-info {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.9rem;
    }

    .produto-nome { font-weight: 700; font-size: 0.9rem; }
    .produto-preco { color: var(--text-color); font-size: 0.9rem; }

  script.
    if (typeof darLike === 'undefined') {
        function darLike(e, btn) {
            e.preventDefault();
            btn.classList.toggle('ativo');
            const liked = btn.classList.contains('ativo');
            const produtoId = btn.dataset.id;
            const data = { produtoId };
            if (liked) {
                axios.post('/wishlist/adicionar', data).catch(err => console.error('erro ao adicionar:', err));
            } else {
                axios.post('/wishlist/remover', data).catch(err => console.error('erro ao remover:', err));
            }
        }
    }