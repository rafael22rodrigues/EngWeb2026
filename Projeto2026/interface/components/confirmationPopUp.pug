mixin confirmationPopUp()
    #confirmation-overlay.overlay 
        .window
            p#confirmation-message-text
            .confirmation-options
                button.confirmation-button(type="button" onclick="closePopup()") Não
            
                form#confirmation-form(action='#' method='POST' style="display: none;")
                    button.confirmation-submit-btn.confirmation-button(type="submit") Sim
                
                button#confirmation-func-btn.confirmation-button(type="button" style="display: none;") Sim
    style.
        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            justify-content: center;
            align-items: center;
            display: none;
            z-index: 1000;
        }

        .window {
            background-color: #fff;
            padding: 40px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 25px;
        }
        
        .window p {
            font-size: 18px;
            margin: 0;
        }
        .confirmation-options {
            display: flex;
            gap: 90px;
        }
        .confirmation-button {
            box-sizing: border-box;
            padding: 10px 20px;
            border: none;
            background-color: #fff; 
            color: var(--main-color);
            cursor: pointer;
            font-size: 16px;
            width: 90px;
            display: flex;            
            align-items: center;
            justify-content: center;
            height: 40px;
            border: 2px solid var(--main-color);
        }

        .confirmation-button:hover {
            background-color:var(--main-color);
            color: #fff;
            cursor: pointer;
            box-sizing: border-box;
        }

        #confirmation-submit {
            display: flex;            
            align-items: center;
            justify-content: center;
            background-color: white;
            width: 90px;
            font-weight: 600;
            background-color: var(--main-color);
            color: #fff;
            border: none;
        }

        #confirmation-submit:hover {
            color: var(--main-color);
            border: 2px solid var(--main-color);
            background-color: #fff;
            text-decoration: none;
            cursor: pointer;
        }

