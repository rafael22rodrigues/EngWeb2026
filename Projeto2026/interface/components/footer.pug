style.
  .footer {
    font-family: 'DM Sans', sans-serif;
    background: #f5f2ee;
    padding: 50px 135px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 250px;
    flex-wrap: wrap;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-color);
  }

  .footer-logo img {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }

  .footer-logo span {
    font-family: 'GFS Didot', serif;
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: normal;
    color: var(--text-color);
  }

  .footer-info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: #444;
  }

  .footer-info p {
    margin: 0;
  }

  .footer-info strong {
    font-weight: 600;
    color: var(--text-color);
  }

  .footer-social {
    display: flex;
    gap: 10px;
    margin-top: 0.5rem;
  }

  .footer-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--text-color);
    border-radius: 50%;
    text-decoration: none;
  }

  .footer-social a img {
    width: 16px;
    height: 16px;
    filter: invert(1);
  }

  .footer-links h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 0.75rem;
    letter-spacing: 0.5px;
  }

  .footer-links a {
    display: block;
    font-size: 0.85rem;
    color: #444;
    text-decoration: none;
    margin-bottom: 0.4rem;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--text-color);
  }
