extends layout

block content
  .w3-card-4 <!-- div -->
    header.w3-container.w3-red
      h1 Filmes em Cartaz
      .w3-container
        table.w3-table-all.w3-margin-top(style="color:black")
          tr
            th ID
            th Título
            th Ano
            th #Elenco
            th #Géneros
          each t in list
            tr(onclick=`window.location='/filmes/${t._id}'` style='cursor:pointer; color:black;' onmouseover="this.style.backgroundColor='#ff7f7f';" onmouseout="this.style.backgroundColor='';")
              td= t._id
              td= t.title
              td= t.year
              td= t.cast.length
              td= t.genres.length