extends layout

block content
    .w3-card-4 <!-- div -->
        header.w3-container.w3-blue
            h1 #{ator.nome}
        - const filmes = (ator.filmes.length)+1
        .w3-container
            table.w3-table-all.w3-margin-top
                tr
                    th Filmes com a participação de #{ator.nome}
                        each a in ator.filmes
                            tr
                                td #{a.title} (#{a.year})
        footer
            a.w3-btn.w3-blue.w3-margin(href="/atores") Voltar