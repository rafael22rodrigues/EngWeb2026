extends layout

block content
    .w3-card-4 <!-- div -->
        header.w3-container.w3-blue
            h1 #{ator._id}
        .w3-container
            table.w3-table-all.w3-margin-top
                tr
                    th Filmes com a participação de #{ator.nome}
                        each a in ator.filmes
                            tr(onclick=`window.location='/filmes/${a.id}'` style='cursor:pointer' onmouseover="this.style.backgroundColor='#89cff0';" onmouseout="this.style.backgroundColor='';")
                                td #{a.titulo} (#{a.ano})
        footer
            a.w3-btn.w3-blue.w3-margin(href="/atores") Voltar