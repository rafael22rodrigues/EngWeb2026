extends layout

block content
    .w3-card-4 <!-- div -->
        header.w3-container.w3-green
            h1 #{genero._id}
        .w3-container
            table.w3-table-all.w3-margin-top
                tr
                    th Filmes de #{genero.nome}
                    each g in genero.filmes
                        tr(onclick=`window.location='/filmes/${g.id}'` style='cursor:pointer' onmouseover="this.style.backgroundColor='#00ff7f';" onmouseout="this.style.backgroundColor='';")
                            td #{g.titulo} (#{g.ano})
        footer
            a.w3-btn.w3-green.w3-margin(href="/generos") Voltar