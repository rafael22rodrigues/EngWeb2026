extends layout 

block content
  .w3-card-4 <!-- div -->
    header.w3-container.w3-red
      h1 #{filme.title} (#{filme.year})
    - const elenco = filme.cast.length;
    - const genero = filme.genres.length;
    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th(style="background-color: #f0f0f0;") Título
          td(style="background-color: white;")= filme.title
        tr
          th(style="background-color: #f0f0f0;") Ano
          td(style="background-color: white;")= filme.year
        tr
          th(rowspan=elenco + 1 style="background-color: #f0f0f0;") Elenco
          each e in filme.cast
            tr(onclick=`window.location='/atores/${encodeURIComponent(e)}'`
              style='cursor: pointer;'
              onmouseover="this.style.backgroundColor='#ff7f7f'; this.querySelector('td').style.backgroundColor='#ff7f7f';"
              onmouseout="this.style.backgroundColor=''; this.querySelector('td').style.backgroundColor='white';")
              td(style="background-color: white;")= e
        tr
          th(rowspan=genero + 1 style="background-color: #f0f0f0;") Género(s)
          each g in filme.genres
            tr(onclick=`window.location='/generos/${encodeURIComponent(g)}'`
              style='cursor: pointer;'
              onmouseover="this.style.backgroundColor='#ff7f7f'; this.querySelector('td').style.backgroundColor='#ff7f7f';"
              onmouseout="this.style.backgroundColor=''; this.querySelector('td').style.backgroundColor='white';")
              td(style="background-color: white;")= g
    footer
      a.w3-btn.w3-red.w3-margin(href="/") Voltar