extends layout

block content
    .w3-card-4 <!-- div -->
        header.w3-container.w3-green
            h1 #{genero.nome}
        .w3-container
            table.w3-table-all.w3-margin-top
                tr
                    th Filmes de #{genero.nome}
                    each g in genero.filmes
                        tr
                            td #{g.title} (#{g.year})
        footer
            a.w3-btn.w3-green.w3-margin(href="/generos") Voltar